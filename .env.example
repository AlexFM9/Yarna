# Proveedor LLM: ollama | openai | gemini | mock
LLM_PROVIDER=ollama

# Configuración de Ollama (Local-First)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# API Keys externas (opcional si no se usa Ollama local)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Configuración STT (faster-whisper)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=models/whisper

# Configuración TTS (Piper ONNX)
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=models/en_US-lessac-medium.onnx.json

# Parámetros de audio y sesión
SAMPLE_RATE=16000
MAX_HISTORY_TURNS=6
